{
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx8G -Xms1g -Xlog:disable",
    "java.debug.settings.onBuildFailureProceed": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "terminal.integrated.profiles.windows": {
        "PowerShell (UTF-8)": {
            "source": "PowerShell",
            "args": [
                "-NoExit",
                "-Command",
                "chcp 65001 > $null"
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "PowerShell (UTF-8)",
    "terminal.integrated.env.windows": {
        "GRADLE_OPTS": "-Dfile.encoding=UTF-8"
    }
}